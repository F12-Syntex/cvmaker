# Copy to .env in the repository root and fill in your own values.
# .env is git-ignored. Never commit real keys.
#
# The Java code reads the GOOGLE_* and EXA_* names below through dotenv-java:
# a variable set in the process environment wins, otherwise the value comes
# from this file.

# Google OAuth client (Desktop app type) used by Gmail and Google Sheets.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ID of the tracking spreadsheet (the long part of its URL). If it is empty
# or cannot be opened, a new "Job Application Tracker" spreadsheet is created.
GOOGLE_SHEETS_ID=your-spreadsheet-id

# Read by ApplicationConfig but not used anywhere yet.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# Exa web search (EmailAnalysisService, ExaSearchClient).
EXA_API_KEY=your-exa-api-key

# ---------------------------------------------------------------------------
# The variables below are NOT read from this file. Export them in your shell.
# ---------------------------------------------------------------------------

# OpenAI (Java: OpenAIOkHttpClient.fromEnv(); also gitinfo.py).
# export OPENAI_API_KEY=your-openai-api-key

# GitHub token for gitinfo.py.
# export GITHUB_KEY=your-github-token
